# systemd user service for the GPU machine. Install:
#   cp antiflipper-rev2.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#   systemctl --user enable --now antiflipper-rev2.service
# Logs: journalctl --user -u antiflipper-rev2 -f      Stop safely: systemctl --user stop antiflipper-rev2
[Unit]
Description=AntiFlipper review experiments (rev2 profile: review controls)
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory=/home/ndag/Desktop/AAR/AntiFlipper/Code_Journal_Experiments
Environment=PYTHONPATH=/home/ndag/.venvs/lightdp-flower-gpu/lib/python3.12/site-packages:/home/ndag/miniconda3/envs/rsa_conda/lib/python3.12/site-packages
Environment=CUDA_VISIBLE_DEVICES=0
Environment=ANTIFLIPPER_PYTHON=/usr/bin/python3.12
Environment=WORKERS=4
ExecStartPre=/usr/bin/python3.12 -c 'import sys, torch; sys.exit(0 if torch.cuda.is_available() else "CUDA unavailable; will retry")'
ExecStart=/bin/bash run_queue.sh rev2
Restart=on-failure
RestartSec=60s
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=5min

[Install]
WantedBy=default.target
